# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
!tcw/serve/dist/
!tcw/serve/dist/**
.pytest_cache/

# Node development artifacts (built tcw/serve/dist assets are committed)
node_modules/
.pnpm-store/
coverage/
playwright-report/
test-results/
.vite/
web-dist/

# Virtualenvs
.venv/
venv/

# Local artifacts
logs/
.worktrees/

# Resolved work: kept on disk and in history, out of the tracked tree.
docs/work/completed/*
!docs/work/completed/.gitkeep
docs/work/discarded/*
!docs/work/discarded/.gitkeep

# Working directory the fixture capture scripts build their throwaway nodes in.
tests/fixtures/*/_scratch/
