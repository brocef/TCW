# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
!tcw/serve/dist/
!tcw/serve/dist/**
.pytest_cache/

# Node development artifacts (built tcw/serve/dist assets are committed)
node_modules/
.pnpm-store/
coverage/
playwright-report/
test-results/
.vite/
web-dist/

# Virtualenvs
.venv/
venv/

# Local artifacts
logs/
.worktrees/

# Personal TCW configuration, never committed.
/tcw-config.local.yaml

# Working directory the fixture capture scripts build their throwaway nodes in.
tests/fixtures/*/_scratch/

# Eval harness: run outputs are disposable, the instrument is not.
eval-runs/
tests/fixtures/eval_grading/*/grading.json
